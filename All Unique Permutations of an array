class Solution {
public:
    void backtrack(vector<int>& arr, vector<bool>& used, vector<int>& temp, vector<vector<int>>& res) {
        if (temp.size() == arr.size()) {
            res.push_back(temp);
            return;
        }
        for (int i = 0; i < arr.size(); i++) {
            if (used[i]) continue;
            if (i > 0 && arr[i] == arr[i-1] && !used[i-1]) continue; // skip duplicates
            used[i] = true;
            temp.push_back(arr[i]);
            backtrack(arr, used, temp, res);
            temp.pop_back();
            used[i] = false;
        }
    }

    vector<vector<int>> uniquePerms(vector<int>& arr) {
        sort(arr.begin(), arr.end()); // sort to handle duplicates
        vector<vector<int>> res;
        vector<int> temp;
        vector<bool> used(arr.size(), false);
        backtrack(arr, used, temp, res);
        return res;
    }
};
