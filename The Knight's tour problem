class Solution {
public:
    vector<vector<int>> knightTour(int n) {
        vector<vector<int>> board(n, vector<int>(n, -1));
        vector<int> dx = {2, 1, -1, -2, -2, -1, 1, 2};
        vector<int> dy = {1, 2, 2, 1, -1, -2, -2, -1};

        board[0][0] = 0; // start at (0,0)
        if (solve(board, 0, 0, 1, dx, dy, n)) 
            return board;
        return {}; // no solution
    }

    bool solve(vector<vector<int>>& board, int x, int y, int step, vector<int>& dx, vector<int>& dy, int n) {
        if (step == n * n) return true; // all cells visited

        for (int i = 0; i < 8; i++) {
            int nx = x + dx[i];
            int ny = y + dy[i];

            if (nx >= 0 && ny >= 0 && nx < n && ny < n && board[nx][ny] == -1) {
                board[nx][ny] = step;
                if (solve(board, nx, ny, step + 1, dx, dy, n)) return true;
                board[nx][ny] = -1; // backtrack
            }
        }
        return false;
    }
};
