class Solution {
  public:
    bool isPalindrome(Node *head) {
        if(!head || !head->next) return true;

        Node *slow = head, *fast = head;
        while(fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }

        Node *prev = NULL, *curr = slow, *next = NULL;
        while(curr) {
            next = curr->next;
            curr->next = prev;
            prev = curr;
            curr = next;
        }

        Node *first = head, *second = prev;
        while(second) {
            if(first->data != second->data) return false;
            first = first->next;
            second = second->next;
        }
        return true;
    }
};
