class Solution {
  public:
    int maxProfit(vector<int>& arr) {
        int n = arr.size();
        if(n <= 1) return 0;
        
        int buy = -arr[0], sell = 0, cooldown = 0;
        
        for(int i = 1; i < n; i++){
            int new_buy = max(buy, cooldown - arr[i]);
            int new_sell = max(sell, buy + arr[i]);
            int new_cooldown = max(cooldown, sell);
            
            buy = new_buy;
            sell = new_sell;
            cooldown = new_cooldown;
        }
        
        return sell;
    }
};
