class Solution {
public:
    int maxEdgesToAdd(int V, vector<vector<int>>& edges) {
        vector<vector<int>> adj(V);
        vector<int> indegree(V, 0);

        // Build adjacency list and indegree
        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            indegree[e[1]]++;
        }

        // Topological sort (Kahn's Algorithm)
        queue<int> q;
        for (int i = 0; i < V; i++)
            if (indegree[i] == 0) q.push(i);

        vector<int> topo;
        while (!q.empty()) {
            int u = q.front(); q.pop();
            topo.push_back(u);
            for (int v : adj[u]) {
                if (--indegree[v] == 0)
                    q.push(v);
            }
        }

        // Reachability matrix (Floyd-Warshall or DFS-based)
        vector<vector<bool>> reachable(V, vector<bool>(V, false));
        for (int u = 0; u < V; u++) {
            queue<int> bfs;
            bfs.push(u);
            while (!bfs.empty()) {
                int x = bfs.front(); bfs.pop();
                for (int v : adj[x]) {
                    if (!reachable[u][v]) {
                        reachable[u][v] = true;
                        bfs.push(v);
                    }
                }
            }
        }

        // Count possible edges that can be added
        int cnt = 0;
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                if (i == j) continue;
                // Edge can go only from earlier to later in topo order
                if (!reachable[i][j] && !reachable[j][i])
                    continue; // Skip disconnected directions
            }
        }

        // Using topo order ensures correct direction
        unordered_map<int,int> pos;
        for (int i = 0; i < V; i++) pos[topo[i]] = i;

        int ans = 0;
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                if (i == j) continue;
                if (pos[i] < pos[j] && !reachable[i][j])
                    ans++;
            }
        }

        return ans;
    }
};
