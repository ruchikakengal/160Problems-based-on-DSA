class Solution {
public:
    struct Node {
        Node* child[2];
        int cnt;
        Node() {
            child[0] = child[1] = NULL;
            cnt = 0;
        }
    };

    void insert(Node* root, int num) {
        for (int i = 31; i >= 0; i--) {
            int b = (num >> i) & 1;
            if (!root->child[b]) root->child[b] = new Node();
            root = root->child[b];
            root->cnt++;
        }
    }

    int query(Node* root, int num, int k) {
        int total = 0;
        for (int i = 31; i >= 0 && root; i--) {
            int nb = (num >> i) & 1;
            int kb = (k >> i) & 1;
            if (kb == 1) {
                if (root->child[nb]) total += root->child[nb]->cnt;
                root = root->child[nb ^ 1];
            } else {
                root = root->child[nb];
            }
        }
        return total;
    }

    int cntPairs(vector<int>& arr, int k) {
        Node* root = new Node();
        int ans = 0;
        for (int x : arr) {
            ans += query(root, x, k);
            insert(root, x);
        }
        return ans;
    }
};
