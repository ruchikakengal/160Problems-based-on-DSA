Input: n = 3
Output: 3   (ways: [1+1+1], [1+2], [2+1])


def climbStairs(n: int) -> int:
    if n <= 2:
        return n
    
    dp = [0] * (n+1)
    dp[1], dp[2] = 1, 2
    
    for i in range(3, n+1):
        dp[i] = dp[i-1] + dp[i-2]
    
    return dp[n]


# Example run
print(climbStairs(3))  # 3
print(climbStairs(5))  # 8
