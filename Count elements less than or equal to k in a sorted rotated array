class Solution {
public:
    int countLessEqual(vector<int>& arr, int x) {
        int n = arr.size();
        int l = 0, r = n - 1;
        
        while (l < r) {
            int mid = (l + r) / 2;
            if (arr[mid] > arr[r]) l = mid + 1;
            else r = mid;
        }
        
        int pivot = l;
        int cnt = 0;
        
        cnt += upper_bound(arr.begin(), arr.begin() + pivot, x) - arr.begin();
        cnt += upper_bound(arr.begin() + pivot, arr.end(), x) - (arr.begin() + pivot);
        
        return cnt;
    }
};
