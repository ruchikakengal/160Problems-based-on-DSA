class Solution {
  public:
  
    bool valid(string s){
        if(s.size() > 1 && s[0] == '0') return false;
        int num = stoi(s);
        return num >= 0 && num <= 255;
    }
    
    void solve(int idx, string s, vector<string>& res, string curr, int parts){
        if(parts == 4 && idx == s.size()){
            curr.pop_back();
            res.push_back(curr);
            return;
        }
        
        if(parts == 4 || idx == s.size()) return;
        
        for(int len = 1; len <= 3 && idx + len <= s.size(); len++){
            string part = s.substr(idx, len);
            if(valid(part)){
                solve(idx + len, s, res, curr + part + ".", parts + 1);
            }
        }
    }
    
    vector<string> generateIp(string &s) {
        vector<string> res;
        solve(0, s, res, "", 0);
        return res;
    }
};
