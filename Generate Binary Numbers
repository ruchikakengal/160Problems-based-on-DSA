#include <bits/stdc++.h>
using namespace std;

class Solution {
  public:
    vector<string> generateBinary(int n) {
        vector<string> ans;
        queue<string> q;
        q.push("1");
        while ((int)ans.size() < n) {
            string s = q.front(); q.pop();
            ans.push_back(s);
            q.push(s + "0");
            q.push(s + "1");
        }
        return ans;
    }
};
