class Solution {
    public void fill(char[][] grid) {
        int n = grid.length, m = grid[0].length;
        boolean[][] visited = new boolean[n][m];
        
        // Mark all 'O's connected to boundary as safe
        for (int i = 0; i < n; i++) {
            if (grid[i][0] == 'O' && !visited[i][0]) dfs(grid, visited, i, 0, n, m);
            if (grid[i][m - 1] == 'O' && !visited[i][m - 1]) dfs(grid, visited, i, m - 1, n, m);
        }
        for (int j = 0; j < m; j++) {
            if (grid[0][j] == 'O' && !visited[0][j]) dfs(grid, visited, 0, j, n, m);
            if (grid[n - 1][j] == 'O' && !visited[n - 1][j]) dfs(grid, visited, n - 1, j, n, m);
        }

        // Replace all unvisited 'O' with 'X'
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (grid[i][j] == 'O' && !visited[i][j]) grid[i][j] = 'X';
            }
        }
    }

    private void dfs(char[][] grid, boolean[][] visited, int i, int j, int n, int m) {
        if (i < 0 || j < 0 || i >= n || j >= m || visited[i][j] || grid[i][j] != 'O') return;
        visited[i][j] = true;
        dfs(grid, visited, i + 1, j, n, m);
        dfs(grid, visited, i - 1, j, n, m);
        dfs(grid, visited, i, j + 1, n, m);
        dfs(grid, visited, i, j - 1, n, m);
    }
}
