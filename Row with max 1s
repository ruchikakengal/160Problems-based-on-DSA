class Solution {
  public:
    int rowWithMax1s(vector<vector<int>> &arr) {
        int n = arr.size();
        int m = arr[0].size();
        int ans = -1;
        int maxOnes = 0;

        for (int i = 0; i < n; i++) {
            int idx = lower_bound(arr[i].begin(), arr[i].end(), 1) - arr[i].begin();
            int ones = m - idx;
            if (ones > maxOnes) {
                maxOnes = ones;
                ans = i;
            }
        }
        return ans;
    }
};
