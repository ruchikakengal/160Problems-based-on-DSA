class Solution {
  public:
    bool canMake(vector<int>& ranks, int n, long long time) {
        long long donuts = 0;
        
        for (int r : ranks) {
            long long t = 0;
            long long k = 1;
            while (t + k * r <= time) {
                t += k * r;
                donuts++;
                k++;
                if (donuts >= n) return true;
            }
        }
        return donuts >= n;
    }
    
    int minTime(vector<int>& ranks, int n) {
        long long low = 0, high = 1e8;
        long long ans = high;
        
        while (low <= high) {
            long long mid = low + (high - low) / 2;
            if (canMake(ranks, n, mid)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return ans;
    }
};
