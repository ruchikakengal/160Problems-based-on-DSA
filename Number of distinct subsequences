class Solution {
  public:
    int distinctSubseq(string &str) {
        const int MOD = 1000000007;
        int n = str.size();

        vector<long long> dp(n + 1, 0);
        vector<long long> last(26, -1);

        dp[0] = 1;

        for(int i = 1; i <= n; i++) {
            dp[i] = (2 * dp[i - 1]) % MOD;
            int c = str[i - 1] - 'a';
            if(last[c] != -1) {
                dp[i] = (dp[i] - dp[last[c]] + MOD) % MOD;
            }
            last[c] = i - 1;
        }

        return (int)dp[n];
    }
};
