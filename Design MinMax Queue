#include <bits/stdc++.h>
using namespace std;

class SpecialQueue {
    queue<int> q;
    deque<int> minDeque, maxDeque;

public:
    void enqueue(int x) {
        q.push(x);

        while (!minDeque.empty() && minDeque.back() > x)
            minDeque.pop_back();
        minDeque.push_back(x);

        while (!maxDeque.empty() && maxDeque.back() < x)
            maxDeque.pop_back();
        maxDeque.push_back(x);
    }

    void dequeue() {
        int val = q.front();
        q.pop();

        if (!minDeque.empty() && minDeque.front() == val)
            minDeque.pop_front();

        if (!maxDeque.empty() && maxDeque.front() == val)
            maxDeque.pop_front();
    }

    int getFront() {
        return q.front();
    }

    int getMin() {
        return minDeque.front();
    }

    int getMax() {
        return maxDeque.front();
    }
};

// Driver
int main() {
    int q;
    cin >> q;
    vector<vector<int>> queries(q);
    for (int i = 0; i < q; i++) {
        int t;
        cin >> t;
        if (t == 1) {
            int x;
            cin >> x;
            queries[i] = {t, x};
        } else {
            queries[i] = {t};
        }
    }

    SpecialQueue sq;
    vector<int> ans;
    for (auto &qr : queries) {
        if (qr[0] == 1) sq.enqueue(qr[1]);
        else if (qr[0] == 2) sq.dequeue();
        else if (qr[0] == 3) ans.push_back(sq.getFront());
        else if (qr[0] == 4) ans.push_back(sq.getMin());
        else if (qr[0] == 5) ans.push_back(sq.getMax());
    }

    for (int x : ans) cout << x << " ";
    return 0;
}



