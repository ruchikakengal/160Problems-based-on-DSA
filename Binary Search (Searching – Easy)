Input: nums = [-1,0,3,5,9,12], target = 9
Output: 4   (since nums[4] = 9)


def binarySearch(nums, target):
    left, right = 0, len(nums) - 1
    while left <= right:
        mid = (left + right) // 2
        if nums[mid] == target:
            return mid
        elif nums[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1


# Example run
print(binarySearch([-1,0,3,5,9,12], 9))  # 4
print(binarySearch([-1,0,3,5,9,12], 2))  # -1
